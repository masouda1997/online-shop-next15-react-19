
#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

pnpm exec commitlint --edit "$1" > /dev/null 2>&1

status=$?

if [ $status -ne 0 ]; then
    echo ""
    echo "\033[0;31m✖ Invalid commit message format.\033[0m"
    echo ""
    echo "  Use →  <type>(<optional scope>): <subject>"
    echo ""
    echo "  Examples:"
    echo "    feat: add login functionality"
    echo "    fix(ui): correct button alignment"
    echo ""
    echo "  Allowed types: feat, fix, docs, style, refactor, perf, test, chore, ci"
    echo ""
    exit 1
fi